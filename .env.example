# ============================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SUPABASE_URL=your-supabase-https-url
# Supabase (Server Keys)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Supabase (Public/Client Keys)
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Session
SESSION_SECRET=your-session-secret-must-be-at-least-32-characters-long

# ============================================
# OPTIONAL ENVIRONMENT VARIABLES
# ============================================

# Branding
APP_NAME=Multi-Tenant
APP_SHORT_NAME=App

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Webhooks (optional)
# APP_WEBHOOK_SECRET=your-webhook-secret

# Email Configuration (optional)
# EMAIL_ADAPTER=supabase  # Options: supabase, sendgrid, resend (default: supabase)
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=noreply@example.com
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@example.com

# Redis (optional)
# REDIS_URL=redis://localhost:6379

# Observability (optional)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# HONEYCOMB_API_KEY=your-honeycomb-api-key
# HONEYCOMB_DATASET=your-dataset-name
# ROLLBAR_ACCESS_TOKEN=your-rollbar-token
# ROLLBAR_ENVIRONMENT=production

# Metrics (optional)
# METRICS_ADAPTERS=in-memory  # Options: in-memory, prometheus, otel (comma-separated, default: in-memory)

# Data Retention (optional, defaults in days)
# LOG_RETENTION_DAYS=90
# SOFT_DELETE_RETENTION_DAYS=30
# AUDIT_LOG_RETENTION_DAYS=365
