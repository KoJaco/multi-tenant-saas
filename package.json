    "devDependencies": {
        "@react-router/dev": "^7.10.1",
        "@tailwindcss/vite": "^4.1.4",
        "@types/jest": "^29.5.14",
        "@types/libhoney": "^4.1.1",
        "@types/node": "^20",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-rsc": "^0.5.6",
        "cypress": "^13.17.0",
        "drizzle-kit": "^0.31.8",
        "jest": "^29.7.0",
