{
    "name": "multi-tenant",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck": "react-router typegen && tsc",
        "setup": "tsx scripts/setup.ts",
        "migrate": "tsx app/lib/db/migrate.ts",
        "seed": "tsx scripts/seed-database.ts",
        "test-supabase-connection": "tsx scripts/test-supabase-connection.ts",
        "test-rls-policies": "tsx scripts/test-rls-policies.ts",
        "remove-test-rls-data": "tsx scripts/remove-test-rls-policies-data.ts",
        "test": "jest",
        "test:unit": "jest --testPathPattern=__tests__ --testPathIgnorePatterns=integration",
        "test:integration": "jest --testPathPattern=integration",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "test:all": "npm run test:unit && npm run test:integration"
    },
    "dependencies": {
        "@radix-ui/react-checkbox": "^1.3.3",
