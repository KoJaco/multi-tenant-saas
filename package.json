        "lucide-react": "^0.542.0",
        "motion": "^12.23.13",
        "nanoid": "^5.1.5",
        "next-themes": "^0.4.6",
        "openai": "^5.21.0",
        "postgres": "^3.4.7",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-router": "^7.10.1",
        "remix-themes": "^2.0.4",
        "sonner": "^2.0.7",
        "stripe": "^18.5.0",
        "tailwind-merge": "^3.3.1",
        "tsx": "^4.21.0",
        "uuid": "^12.0.0",
        "zod": "^3.25.76"
